{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.modulosprefabricadossanjose.com"
        }
      ],
      "destination": "https://modulosprefabricadossanjose.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/catalogo", "destination": "/index.html" },
    { "source": "/catalogo/modulo-3x240", "destination": "/index.html" },
    { "source": "/catalogo/modulo-4x240", "destination": "/index.html" },
    { "source": "/catalogo/modulo-5x240", "destination": "/index.html" },
    { "source": "/catalogo/modulo-6x240", "destination": "/index.html" },
    { "source": "/catalogo/modulo-7x240", "destination": "/index.html" }
  ]
}
